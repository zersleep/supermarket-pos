# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection
# Note: For Neon, use the pooled connection string (with ?sslmode=require)
DATABASE_URL="postgresql://username:password@ep-your-database-host.region.aws.neon.tech/neondb?sslmode=require"

# Security & Authentication
JWT_SECRET="replace-with-a-secure-random-32-plus-character-secret"
JWT_EXPIRES_IN="12h"

# CORS Allowed Origin (Frontend URL)
CLIENT_URL="http://localhost:5173"

# One-time owner initialization setup token (Optional, protects /api/auth/setup)
SETUP_SECRET="pos-setup-secret-key"

// Prisma Schema for Supermarket POS System
// Configured for PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// 1. USERS & ROLES
// -------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  CASHIER
  INVENTORY_MANAGER
}

model User {
  id                    String            @id @default(uuid())
  username              String            @unique
  email                 String?           @unique
  passwordHash          String
  fullName              String
  role                  Role              @default(CASHIER)
  isActive              Boolean           @default(true)
  phone                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relationships
  shifts                CashierShift[]
  sales                 Sale[]
  stockMovements        StockMovement[]
  auditLogs             AuditLog[]
  paymentsConfirmed     Payment[]         @relation("ConfirmedPayments")
  cashMovements         CashMovement[]
  purchaseOrdersCreated PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  refundsProcessed      Refund[]

  @@index([username])
  @@index([role])
}

// -------------------------------------------------------------
// 2. CATEGORIES & PRODUCTS
// -------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id                String            @id @default(uuid())
  name              String
  sku               String            @unique
  barcode           String?           @unique
  description       String?
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costPrice         Decimal           @db.Decimal(12, 2)
  sellingPrice      Decimal           @db.Decimal(12, 2)
  wholesalePrice    Decimal?          @db.Decimal(12, 2)
  unit              String            @default("piece") // piece, kg, box, bottle, pack
  reorderLevel      Int               @default(10)
  trackExpiry       Boolean           @default(true)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relationships
  barcodes          ProductBarcode[]
  batches           InventoryBatch[]
  stockMovements    StockMovement[]
  saleItems         SaleItem[]
  poItems           PurchaseOrderItem[]
  receiptItems      GoodsReceiptItem[]

  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
}

model ProductBarcode {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode         String   @unique
  type            String   @default("PRIMARY") // PRIMARY, SECONDARY, BOX, PACK
  unitsPerBarcode Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([barcode])
  @@index([productId])
}

// -------------------------------------------------------------
// 3. INVENTORY, BATCHES & STOCK MOVEMENTS (FEFO SUPPORT)
// -------------------------------------------------------------

model InventoryBatch {
  id              String             @id @default(uuid())
  batchNumber     String
  productId       String
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  initialQuantity Decimal            @db.Decimal(12, 2)
  currentQuantity Decimal            @db.Decimal(12, 2)
  costPrice       Decimal            @db.Decimal(12, 2)
  receivedAt      DateTime           @default(now())
  expiryDate      DateTime?
  isWriteOff      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  receiptItems    GoodsReceiptItem[]

  @@index([productId, expiryDate])
  @@index([batchNumber])
}

enum MovementType {
  OPENING_STOCK
  RECEIPT
  SALE
  ADJUSTMENT_ADD
  ADJUSTMENT_SUBTRACT
  RETURN_RESTOCK
  WRITE_OFF_EXPIRED
  WRITE_OFF_DAMAGED
}

model StockMovement {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId       String?
  batch         InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  movementType  MovementType
  quantity      Decimal         @db.Decimal(12, 2) // positive for increases, negative for reductions
  previousStock Decimal         @db.Decimal(12, 2)
  newStock      Decimal         @db.Decimal(12, 2)
  referenceType String?         // "SALE", "RECEIPT", "ADJUSTMENT", "WRITE_OFF"
  referenceId   String?
  reason        String?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([movementType])
  @@index([referenceType, referenceId])
}

// -------------------------------------------------------------
// 4. SUPPLIERS & PURCHASING
// -------------------------------------------------------------

model Supplier {
  id            String          @id @default(uuid())
  name          String          @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  purchaseOrders PurchaseOrder[]
}

enum POStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  poNumber        String              @unique
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status          POStatus            @default(DRAFT)
  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  totalCost       Decimal             @db.Decimal(12, 2) @default(0)
  notes           String?
  createdByUserId String?
  createdByUser   User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items           PurchaseOrderItem[]
  receipts        GoodsReceipt[]

  @@index([poNumber])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String             @id @default(uuid())
  poId             String
  po               PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityOrdered  Decimal            @db.Decimal(12, 2)
  quantityReceived Decimal            @db.Decimal(12, 2) @default(0)
  unitCost         Decimal            @db.Decimal(12, 2)
  lineTotal        Decimal            @db.Decimal(12, 2)

  receiptItems     GoodsReceiptItem[]
}

model GoodsReceipt {
  id                String             @id @default(uuid())
  receiptNumber     String             @unique
  poId              String
  po                PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Restrict)
  receivedByUserId  String?
  receivedByUser    User?              @relation(fields: [receivedByUserId], references: [id], onDelete: SetNull)
  receivedAt        DateTime           @default(now())
  notes             String?

  items             GoodsReceiptItem[]

  @@index([receiptNumber])
  @@index([poId])
}

model GoodsReceiptItem {
  id               String             @id @default(uuid())
  receiptId        String
  receipt          GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poItemId         String?
  poItem           PurchaseOrderItem? @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId          String?
  batch            InventoryBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantityReceived Decimal            @db.Decimal(12, 2)
  unitCost         Decimal            @db.Decimal(12, 2)
  batchNumber      String?
  expiryDate       DateTime?
}

// -------------------------------------------------------------
// 5. CUSTOMERS, CASHIER SHIFTS & CASH MOVEMENTS
// -------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?  @unique
  email     String?
  points    Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashierShift {
  id                  String         @id @default(uuid())
  cashierId           String
  cashier             User           @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  openedAt            DateTime       @default(now())
  closedAt            DateTime?
  status              ShiftStatus    @default(OPEN)
  openingCash         Decimal        @db.Decimal(12, 2)
  cashSalesTotal      Decimal        @db.Decimal(12, 2) @default(0)
  cashInTotal         Decimal        @db.Decimal(12, 2) @default(0)
  cashOutTotal        Decimal        @db.Decimal(12, 2) @default(0)
  expectedClosingCash Decimal        @db.Decimal(12, 2) @default(0)
  actualClosingCash   Decimal?       @db.Decimal(12, 2)
  difference          Decimal?       @db.Decimal(12, 2)
  notes               String?

  sales               Sale[]
  cashMovements       CashMovement[]

  @@index([cashierId, status])
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

model CashMovement {
  id        String           @id @default(uuid())
  shiftId   String
  shift     CashierShift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  reason    String
  createdAt DateTime         @default(now())

  @@index([shiftId])
}

// -------------------------------------------------------------
// 6. SALES, SALE ITEMS, PAYMENTS & REFUNDS
// -------------------------------------------------------------

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Sale {
  id             String      @id @default(uuid())
  saleNumber     String      @unique
  receiptNumber  String      @unique
  cashierId      String?
  cashier        User?       @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  shiftId        String?
  shift          CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountTotal  Decimal     @db.Decimal(12, 2) @default(0)
  taxTotal       Decimal     @db.Decimal(12, 2) @default(0)
  grandTotal     Decimal     @db.Decimal(12, 2)
  paymentStatus  SaleStatus  @default(PENDING)
  idempotencyKey String?     @unique
  notes          String?
  createdAt      DateTime    @default(now())
  completedAt    DateTime?

  items          SaleItem[]
  payments       Payment[]
  refunds        Refund[]

  @@index([saleNumber])
  @@index([receiptNumber])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([cashierId])
}

model SaleItem {
  id                  String          @id @default(uuid())
  saleId              String
  sale                Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId           String
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId             String?
  batch               InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Decimal         @db.Decimal(12, 2)
  costPriceSnapshot   Decimal         @db.Decimal(12, 2) @default(0)
  quantity            Decimal         @db.Decimal(12, 2)
  discountAmount      Decimal         @db.Decimal(12, 2) @default(0)
  lineTotal           Decimal         @db.Decimal(12, 2)

  refundItems         RefundItem[]

  @@index([saleId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  QR_PAYMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

model Payment {
  id                 String        @id @default(uuid())
  saleId             String
  sale               Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  method             PaymentMethod
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("USD") // "USD" or "KHR"
  status             PaymentStatus @default(PENDING)
  transactionRef     String?
  qrCodeData         String?
  cashReceived       Decimal?      @db.Decimal(12, 2)
  changeGiven        Decimal?      @db.Decimal(12, 2)
  confirmedByUserId  String?
  confirmedByUser    User?         @relation("ConfirmedPayments", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([saleId])
  @@index([transactionRef])
}

model Refund {
  id                  String       @id @default(uuid())
  refundNumber        String       @unique
  originalSaleId      String
  originalSale        Sale         @relation(fields: [originalSaleId], references: [id], onDelete: Restrict)
  processedByUserId   String?
  processedByUser     User?        @relation(fields: [processedByUserId], references: [id], onDelete: SetNull)
  totalRefundAmount   Decimal      @db.Decimal(12, 2)
  reason              String
  createdAt           DateTime     @default(now())

  items               RefundItem[]

  @@index([refundNumber])
  @@index([originalSaleId])
}

model RefundItem {
  id               String          @id @default(uuid())
  refundId         String
  refund           Refund          @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItemId       String
  saleItem         SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  quantity         Decimal         @db.Decimal(12, 2)
  refundAmount     Decimal         @db.Decimal(12, 2)
  restocked        Boolean         @default(false)
  restockCondition String?         // "GOOD", "DAMAGED", "EXPIRED"

  @@index([refundId])
}

// -------------------------------------------------------------
// 7. AUDIT LOGS & APPLICATION SETTINGS
// -------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "AUTH_LOGIN", "PRODUCT_CREATE", "STOCK_ADJUSTMENT", "PAYMENT_CONFIRM"
  entityType String   // "User", "Product", "Sale", "Payment", "Shift", "InventoryBatch", "PurchaseOrder"
  entityId   String?
  details    Json?    // Context, diffs, IP, metadata
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "STORE_NAME", "STORE_ADDRESS", "CURRENCY_CODE", "EXCHANGE_RATE_KHR", "TAX_PERCENT", "EXPIRY_WARNING_DAYS"
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
